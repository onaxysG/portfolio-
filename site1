<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WorldForge: Fictional Character Archive & Registry</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;800&family=Orbitron:wght@400;600;800&family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        aurora: {
                            green: '#00ffcc',
                            cyan: '#00d8ff',
                            violet: '#7928ca',
                            magenta: '#ff0080',
                            gold: '#ffb703'
                        },
                        darkbg: '#070913',
                        panel: '#0f1429',
                        panelHover: '#171e3b'
                    },
                    fontFamily: {
                        cinzel: ['Cinzel', 'serif'],
                        orbitron: ['Orbitron', 'sans-serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #070913;
            color: #e2e8f0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        /* Interactive Canvas Aurora Background */
        #auroraCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 0;
            pointer-events: none;
        }

        /* Glassmorphism Styles */
        .glass-panel {
            background: rgba(15, 20, 41, 0.78);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-card {
            background: rgba(20, 27, 54, 0.68);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-4px);
            border-color: rgba(0, 216, 255, 0.45);
            box-shadow: 0 12px 30px -10px rgba(0, 216, 255, 0.28);
        }

        /* GIF-style Animated Genre Badges */
        .genre-gif-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .genre-icon {
            display: inline-block;
        }

        /* Fantasy GIF effect */
        .badge-fantasy {
            background: linear-gradient(135deg, #4c1d95, #7c3aed);
            color: #ede9fe;
            border: 1px solid #a78bfa;
            animation: fantasyFloat 2.5s infinite ease-in-out;
        }
        .badge-fantasy .genre-icon {
            animation: crystalSpin 3s infinite linear;
        }
        @keyframes fantasyFloat {
            0%, 100% { transform: translateY(0); box-shadow: 0 0 8px rgba(167, 139, 250, 0.5); }
            50% { transform: translateY(-3px); box-shadow: 0 0 18px rgba(167, 139, 250, 0.9); }
        }
        @keyframes crystalSpin {
            0% { transform: rotate(0deg) scale(1); }
            50% { transform: rotate(180deg) scale(1.2); }
            100% { transform: rotate(360deg) scale(1); }
        }

        /* Sci-Fi GIF effect */
        .badge-scifi {
            background: linear-gradient(135deg, #0c4a6e, #0284c7);
            color: #e0f2fe;
            border: 1px solid #38bdf8;
            animation: scifiPulse 1.8s infinite alternate ease-in-out;
        }
        .badge-scifi .genre-icon {
            animation: rocketLaunch 2s infinite ease-in-out;
        }
        @keyframes scifiPulse {
            0% { box-shadow: 0 0 5px #0284c7, inset 0 0 2px #38bdf8; }
            100% { box-shadow: 0 0 16px #38bdf8, inset 0 0 8px #0284c7; }
        }
        @keyframes rocketLaunch {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(2px, -2px) scale(1.15); }
        }

        /* Cyberpunk GIF effect */
        .badge-cyberpunk {
            background: linear-gradient(135deg, #831843, #db2777);
            color: #fce7f3;
            border: 1px solid #f472b6;
            animation: cyberpunkGlitch 1.2s infinite steps(2, start);
        }
        .badge-cyberpunk .genre-icon {
            animation: zapFlash 0.6s infinite alternate;
        }
        @keyframes cyberpunkGlitch {
            0% { transform: translate(0, 0); box-shadow: -2px 0 #00ffff, 2px 0 #ff00ff; }
            25% { transform: translate(-1px, 1px); box-shadow: 2px 0 #00ffff, -2px 0 #ff00ff; }
            50% { transform: translate(1px, -1px); box-shadow: -1px 0 #00ffff, 1px 0 #ff00ff; }
            75% { transform: translate(-1px, 0); box-shadow: 1px 0 #00ffff, -1px 0 #ff00ff; }
            100% { transform: translate(0, 0); box-shadow: -2px 0 #00ffff, 2px 0 #ff00ff; }
        }
        @keyframes zapFlash {
            0% { opacity: 0.6; filter: hue-rotate(0deg); }
            100% { opacity: 1; filter: hue-rotate(90deg); }
        }

        /* Steampunk GIF effect */
        .badge-steampunk {
            background: linear-gradient(135deg, #78350f, #d97706);
            color: #fef3c7;
            border: 1px solid #fbbf24;
            animation: steampunkGlow 3s infinite alternate;
        }
        .badge-steampunk .genre-icon {
            animation: gearTurn 4s infinite linear;
        }
        @keyframes gearTurn {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        @keyframes steampunkGlow {
            0% { box-shadow: 0 0 4px #d97706; }
            100% { box-shadow: 0 0 14px #fbbf24; }
        }

        /* Horror GIF effect */
        .badge-horror {
            background: linear-gradient(135deg, #450a0a, #991b1b);
            color: #fee2e2;
            border: 1px solid #f87171;
            animation: horrorPulse 1.5s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
        }
        .badge-horror .genre-icon {
            animation: eyeBlink 3s infinite ease-in-out;
        }
        @keyframes horrorPulse {
            0% { transform: scale(1); box-shadow: 0 0 4px #991b1b; }
            14% { transform: scale(1.06); box-shadow: 0 0 16px #ef4444; }
            28% { transform: scale(1); box-shadow: 0 0 4px #991b1b; }
            42% { transform: scale(1.04); box-shadow: 0 0 12px #dc2626; }
            70% { transform: scale(1); box-shadow: 0 0 4px #991b1b; }
        }
        @keyframes eyeBlink {
            0%, 45%, 55%, 100% { transform: scaleY(1); }
            50% { transform: scaleY(0.1); }
        }

        /* Superhero GIF effect */
        .badge-superhero {
            background: linear-gradient(135deg, #1e3a8a, #2563eb);
            color: #dbeafe;
            border: 1px solid #60a5fa;
            animation: heroBounce 2s infinite ease-in-out;
        }
        .badge-superhero .genre-icon {
            animation: heroShine 1.5s infinite alternate;
        }
        @keyframes heroBounce {
            0%, 100% { transform: translateY(0); box-shadow: 0 0 6px #2563eb; }
            50% { transform: translateY(-4px) scale(1.03); box-shadow: 0 0 16px #60a5fa; }
        }
        @keyframes heroShine {
            0% { filter: brightness(1); }
            100% { filter: brightness(1.6); }
        }

        /* Holographic Card Effect */
        .holo-card {
            position: relative;
            overflow: hidden;
        }
        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                115deg,
                transparent 20%,
                rgba(0, 216, 255, 0.12) 40%,
                rgba(255, 0, 128, 0.12) 60%,
                transparent 80%
            );
            transform: rotate(30deg);
            transition: all 0.6s ease;
            pointer-events: none;
        }
        .holo-card:hover::before {
            transform: rotate(30deg) translate(20%, 20%);
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(7, 9, 19, 0.8);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 216, 255, 0.5);
        }
    </style>
</head>
<body class="relative min-h-screen text-slate-200">

    <!-- Interactive Canvas Background -->
    <canvas id="auroraCanvas"></canvas>

    <div class="relative z-10 flex flex-col min-h-screen">
        
        <!-- HEADER / NAVBAR -->
        <header class="sticky top-0 z-40 glass-panel border-b border-slate-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-20">
                    <!-- Brand Logo -->
                    <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('registry')">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-cyan-500 via-indigo-600 to-pink-500 p-0.5 shadow-lg shadow-cyan-500/20">
                            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
                                <i class="fa-solid fa-cube text-cyan-400 text-xl animate-pulse"></i>
                            </div>
                        </div>
                        <div>
                            <h1 class="font-cinzel text-xl font-bold bg-gradient-to-r from-cyan-300 via-indigo-200 to-pink-400 bg-clip-text text-transparent tracking-wide">
                                WORLDFORGE
                            </h1>
                            <p class="text-[10px] font-orbitron text-slate-400 tracking-widest uppercase">
                                Fictional Codex & Archive
                            </p>
                        </div>
                    </div>

                    <!-- Navigation Tabs -->
                    <nav class="hidden md:flex items-center space-x-2">
                        <button onclick="switchTab('registry')" id="nav-registry" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center space-x-2 text-cyan-400 bg-slate-800/80 border border-cyan-500/30">
                            <i class="fa-solid fa-book-bookmark"></i>
                            <span>Registry</span>
                        </button>
                        <button onclick="switchTab('creator')" id="nav-creator" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold text-slate-400 hover:text-slate-100 hover:bg-slate-800/50 transition flex items-center space-x-2">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                            <span>Forge Character</span>
                        </button>
                        <button onclick="switchTab('arena')" id="nav-arena" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold text-slate-400 hover:text-slate-100 hover:bg-slate-800/50 transition flex items-center space-x-2">
                            <i class="fa-solid fa-swords text-amber-400"></i>
                            <span>Battle Arena</span>
                        </button>
                        <button onclick="switchTab('lorespark')" id="nav-lorespark" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold text-slate-400 hover:text-slate-100 hover:bg-slate-800/50 transition flex items-center space-x-2">
                            <i class="fa-solid fa-brain text-pink-400"></i>
                            <span>Lore Spark</span>
                        </button>
                    </nav>

                    <!-- User Persona Switcher -->
                    <div class="relative">
                        <button id="personaBtn" onclick="togglePersonaDropdown()" class="flex items-center space-x-3 px-3 py-1.5 rounded-full bg-slate-900/80 border border-slate-700 hover:border-cyan-500/50 transition">
                            <img id="activeAvatar" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" class="w-8 h-8 rounded-full object-cover border border-cyan-400">
                            <div class="text-left hidden sm:block">
                                <p id="activeName" class="text-xs font-bold text-slate-200">Valen Weaver</p>
                                <p id="activeHandle" class="text-[10px] text-cyan-400">@valen_weaver</p>
                            </div>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400 ml-1"></i>
                        </button>

                        <!-- Dropdown Menu -->
                        <div id="personaMenu" class="hidden absolute right-0 mt-2 w-64 glass-panel rounded-xl shadow-2xl py-2 z-50 border border-slate-700">
                            <div class="px-4 py-2 border-b border-slate-800">
                                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Active Persona</p>
                            </div>
                            <div id="personaList" class="py-1"></div>
                            <div class="border-t border-slate-800 pt-1 px-2">
                                <button onclick="togglePersonaDropdown(); openProfileModal(currentPersona.handle)" class="w-full text-left px-3 py-2 text-xs font-medium text-cyan-400 hover:bg-slate-800/50 rounded-lg flex items-center space-x-2">
                                    <i class="fa-solid fa-user-gear"></i>
                                    <span>View & Edit My Profile Codex</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mobile Nav Bar -->
                <div class="flex md:hidden items-center justify-around py-2 border-t border-slate-800/80 text-xs">
                    <button onclick="switchTab('registry')" class="text-cyan-400 font-semibold py-1"><i class="fa-solid fa-book-bookmark mr-1"></i>Registry</button>
                    <button onclick="switchTab('creator')" class="text-slate-300 font-semibold py-1"><i class="fa-solid fa-wand-magic-sparkles mr-1"></i>Forge</button>
                    <button onclick="switchTab('arena')" class="text-slate-300 font-semibold py-1"><i class="fa-solid fa-swords mr-1"></i>Arena</button>
                    <button onclick="switchTab('lorespark')" class="text-slate-300 font-semibold py-1"><i class="fa-solid fa-brain mr-1"></i>Spark</button>
                </div>
            </div>
        </header>

        <!-- MAIN CONTENT CONTAINER -->
        <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

            <!-- TAB 1: REGISTRY & ARCHIVE -->
            <section id="tab-registry-content" class="tab-content space-y-8">

                <!-- Hero Section & Filters -->
                <div class="glass-panel p-6 sm:p-8 rounded-2xl relative overflow-hidden">
                    <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-gradient-to-br from-cyan-500/10 to-pink-500/10 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
                        <div class="max-w-2xl">
                            <span class="px-3 py-1 text-xs font-semibold rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 uppercase tracking-widest font-orbitron">
                                Multiverse Directory
                            </span>
                            <h2 class="text-3xl sm:text-4xl font-cinzel font-bold text-white mt-3">
                                Fictional Entity Archive
                            </h2>
                            <p class="text-slate-400 text-sm mt-2 leading-relaxed">
                                Explore, publish, and engage with original fictional characters. Powered by dynamic Auroric energy that shifts with your cursor and custom lore crafting.
                            </p>
                        </div>

                        <!-- Main Feed Filters -->
                        <div class="flex flex-wrap items-center gap-2 bg-slate-950/60 p-1.5 rounded-xl border border-slate-800">
                            <button onclick="setFeedFilter('all')" id="feed-filter-all" class="feed-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition text-cyan-400 bg-slate-800">
                                Public Codex
                            </button>
                            <button onclick="setFeedFilter('mine')" id="feed-filter-mine" class="feed-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition text-slate-400 hover:text-white">
                                My Characters
                            </button>
                            <button onclick="setFeedFilter('liked')" id="feed-filter-liked" class="feed-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition text-slate-400 hover:text-white flex items-center gap-1.5">
                                <i class="fa-solid fa-heart text-pink-500"></i> Liked
                            </button>
                        </div>
                    </div>

                    <!-- Search & Secondary Filter Controls -->
                    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-4">
                        <div class="md:col-span-5 relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                            <input type="text" id="searchInput" oninput="renderRegistry()" placeholder="Search name, archetype, lore, or author..." class="w-full bg-slate-950/80 border border-slate-800 rounded-xl pl-11 pr-4 py-3 text-sm focus:outline-none focus:border-cyan-500 transition text-slate-100 placeholder-slate-500">
                        </div>

                        <div class="md:col-span-3">
                            <select id="alignmentFilter" onchange="renderRegistry()" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-cyan-500 text-slate-200">
                                <option value="all">All Alignments</option>
                                <option value="Lawful Good">Lawful Good</option>
                                <option value="Chaotic Good">Chaotic Good</option>
                                <option value="True Neutral">True Neutral</option>
                                <option value="Chaotic Neutral">Chaotic Neutral</option>
                                <option value="Lawful Evil">Lawful Evil</option>
                                <option value="Chaotic Evil">Chaotic Evil</option>
                            </select>
                        </div>

                        <div class="md:col-span-4">
                            <select id="sortSelect" onchange="renderRegistry()" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-cyan-500 text-slate-200">
                                <option value="trending">❤️ Trending (Most Liked)</option>
                                <option value="newest">✨ Newest Releases</option>
                                <option value="power">⚡ Highest Power Score</option>
                                <option value="alphabetical">🔤 Alphabetical (A-Z)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Animated Genre Filter Pills -->
                    <div class="mt-6 flex flex-wrap items-center gap-2">
                        <span class="text-xs font-semibold text-slate-400 mr-2 uppercase tracking-wider font-orbitron">Genre:</span>
                        <button onclick="setGenreFilter('all')" id="genre-pill-all" class="genre-pill px-3 py-1.5 rounded-full text-xs font-bold bg-slate-800 text-cyan-400 border border-cyan-500/40">
                            All Genres
                        </button>
                        <button onclick="setGenreFilter('Fantasy')" id="genre-pill-Fantasy" class="genre-pill genre-gif-badge badge-fantasy opacity-80 hover:opacity-100">
                            <span class="genre-icon">🔮</span> Fantasy
                        </button>
                        <button onclick="setGenreFilter('Sci-Fi')" id="genre-pill-Sci-Fi" class="genre-pill genre-gif-badge badge-scifi opacity-80 hover:opacity-100">
                            <span class="genre-icon">🚀</span> Sci-Fi
                        </button>
                        <button onclick="setGenreFilter('Cyberpunk')" id="genre-pill-Cyberpunk" class="genre-pill genre-gif-badge badge-cyberpunk opacity-80 hover:opacity-100">
                            <span class="genre-icon">⚡</span> Cyberpunk
                        </button>
                        <button onclick="setGenreFilter('Steampunk')" id="genre-pill-Steampunk" class="genre-pill genre-gif-badge badge-steampunk opacity-80 hover:opacity-100">
                            <span class="genre-icon">⚙️</span> Steampunk
                        </button>
                        <button onclick="setGenreFilter('Horror')" id="genre-pill-Horror" class="genre-pill genre-gif-badge badge-horror opacity-80 hover:opacity-100">
                            <span class="genre-icon">👁️</span> Horror
                        </button>
                        <button onclick="setGenreFilter('Superhero')" id="genre-pill-Superhero" class="genre-pill genre-gif-badge badge-superhero opacity-80 hover:opacity-100">
                            <span class="genre-icon">🦸</span> Superhero
                        </button>
                    </div>
                </div>

                <!-- Characters Grid -->
                <div id="characterGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

                <!-- Empty State -->
                <div id="emptyState" class="hidden text-center py-16 glass-panel rounded-2xl">
                    <i class="fa-solid fa-ghost text-5xl text-slate-600 mb-4 animate-bounce"></i>
                    <h3 class="text-xl font-bold font-cinzel text-slate-300">No Fictional Entities Found</h3>
                    <p class="text-sm text-slate-500 mt-1">Try adjusting your search criteria or forge a new character!</p>
                </div>
            </section>

            <!-- TAB 2: CHARACTER FORGE / CREATOR -->
            <section id="tab-creator-content" class="tab-content hidden space-y-8">
                <div class="glass-panel p-6 sm:p-8 rounded-2xl">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-6 mb-8">
                        <div>
                            <h2 class="text-2xl sm:text-3xl font-cinzel font-bold text-white flex items-center gap-3">
                                <i class="fa-solid fa-hammer text-cyan-400"></i>
                                Forge New Entity
                            </h2>
                            <p class="text-slate-400 text-sm mt-1">Design stats, backstory, and publication state for your character.</p>
                        </div>

                        <!-- Draft vs Published Toggle -->
                        <div class="flex items-center bg-slate-950 p-1.5 rounded-xl border border-slate-800 self-start">
                            <button type="button" onclick="setFormStatus('draft')" id="status-btn-draft" class="px-4 py-2 rounded-lg text-xs font-bold transition text-slate-400">
                                <i class="fa-solid fa-lock mr-1.5"></i> Save as Draft
                            </button>
                            <button type="button" onclick="setFormStatus('published')" id="status-btn-published" class="px-4 py-2 rounded-lg text-xs font-bold transition bg-cyan-500 text-slate-950 font-semibold shadow-lg shadow-cyan-500/30">
                                <i class="fa-solid fa-globe mr-1.5"></i> Publish to Codex
                            </button>
                        </div>
                    </div>

                    <form id="characterForm" onsubmit="handleCharacterSubmit(event)" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                        <div class="lg:col-span-7 space-y-6">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Character Name *</label>
                                    <input type="text" id="inputName" required placeholder="e.g., Aetheris Sunstride" oninput="updateLivePreview()" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:border-cyan-500 focus:outline-none">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Title / Epithet *</label>
                                    <input type="text" id="inputTitle" required placeholder="e.g., The Astral Sentinel" oninput="updateLivePreview()" class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:border-cyan-500 focus:outline-none">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
