        function handleCharacterSubmit(e) {
            e.preventDefault();

            const newChar = {
                id: "char-" + Date.now(),
                name: document.getElementById('inputName').value,
                title: document.getElementById('inputTitle').value,
                genre: document.getElementById('inputGenre').value,
                alignment: document.getElementById('inputAlignment').value,
                avatar: document.getElementById('inputAvatar').value || "https://images.unsplash.com/photo-1578632767115-351597cf2477?w=500&auto=format&fit=crop&q=80",
                authorHandle: currentPersona.handle,
                status: currentFormStatus,
                likes: 0,
                likedBy: [],
                stats: {
                    str: parseInt(document.getElementById('statStr').value),
                    agi: parseInt(document.getElementById('statAgi').value),
                    int: parseInt(document.getElementById('statInt').value),
                    mag: parseInt(document.getElementById('statMag').value),
                    cha: parseInt(document.getElementById('statCha').value)
                },
                backstory: document.getElementById('inputBackstory').value,
                ability: document.getElementById('inputAbility').value || "Celestial Surge",
                weakness: document.getElementById('inputWeakness').value || "Overexertion",
                comments: []
            };

            characters.unshift(newChar);
            saveData();
            document.getElementById('characterForm').reset();
            updateLivePreview();
            switchTab('registry');
            renderRegistry();
        }

