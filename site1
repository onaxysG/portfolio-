                <button onclick="switchPersona('${p.handle}')" class="w-full text-left px-4 py-2.5 hover:bg-slate-800/60 transition flex items-center space-x-3 ${p.handle === currentPersona.handle ? 'bg-slate-800/40 border-l-2 border-cyan-400' : ''}">
                    <img src="${p.avatar}" class="w-7 h-7 rounded-full object-cover">
                    <div>
                        <p class="text-xs font-semibold text-slate-200">${p.name}</p>
                        <p class="text-[10px] text-slate-400">${p.handle}</p>
                    </div>
                </button>
            `).join('');
        }

        function switchPersona(handle) {
            const found = personas.find(p => p.handle === handle);
            if (found) {
                currentPersona = found;
                renderPersonaDropdown();
                renderRegistry();
                updateLivePreview();
                togglePersonaDropdown();
            }
        }

        // ==========================================
        // 5. REGISTRY & FEED RENDERER
        // ==========================================
        function setFeedFilter(filter) {
            currentFeedFilter = filter;
            document.querySelectorAll('.feed-tab-btn').forEach(b => {
                b.className = "feed-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition text-slate-400 hover:text-white";
            });
            const active = document.getElementById(`feed-filter-${filter}`);
            if (active) active.className = "feed-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition text-cyan-400 bg-slate-800";
            renderRegistry();
        }

        function setGenreFilter(genre) {
            currentGenreFilter = genre;
            document.querySelectorAll('.genre-pill').forEach(p => {
                p.classList.add('opacity-80');
                p.classList.remove('ring-2', 'ring-cyan-400');
            });
            const active = document.getElementById(`genre-pill-${genre}`);
            if (active) {
                active.classList.remove('opacity-80');
                active.classList.add('ring-2', 'ring-cyan-400');
            }
            renderRegistry();
        }

        function getGenreBadgeHTML(genre) {
            const map = {
                'Fantasy': '<span class="genre-gif-badge badge-fantasy"><span class="genre-icon">🔮</span> Fantasy</span>',
                'Sci-Fi': '<span class="genre-gif-badge badge-scifi"><span class="genre-icon">🚀</span> Sci-Fi</span>',
                'Cyberpunk': '<span class="genre-gif-badge badge-cyberpunk"><span class="genre-icon">⚡</span> Cyberpunk</span>',
                'Steampunk': '<span class="genre-gif-badge badge-steampunk"><span class="genre-icon">⚙️</span> Steampunk</span>',
                'Horror': '<span class="genre-gif-badge badge-horror"><span class="genre-icon">👁️</span> Horror</span>',
                'Superhero': '<span class="genre-gif-badge badge-superhero"><span class="genre-icon">🦸</span> Superhero</span>'
            };
            return map[genre] || `<span class="genre-gif-badge badge-fantasy">${genre}</span>`;
        }

        function calculatePowerScore(stats) {
            return Math.round((stats.str + stats.agi + stats.int + stats.mag + stats.cha) / 5);
        }

        function renderRegistry() {
            const grid = document.getElementById('characterGrid');
            const emptyState = document.getElementById('emptyState');

            const search = document.getElementById('searchInput').value.toLowerCase();
            const alignment = document.getElementById('alignmentFilter').value;
            const sort = document.getElementById('sortSelect').value;

            let filtered = characters.filter(c => {
                if (currentFeedFilter === 'all' && c.status !== 'published' && c.authorHandle !== currentPersona.handle) return false;
                if (currentFeedFilter === 'mine' && c.authorHandle !== currentPersona.handle) return false;
                if (currentFeedFilter === 'liked' && !c.likedBy.includes(currentPersona.handle)) return false;

                const matchesSearch = c.name.toLowerCase().includes(search) || 
                                      c.title.toLowerCase().includes(search) || 
                                      c.backstory.toLowerCase().includes(search) ||
                                      c.authorHandle.toLowerCase().includes(search);
                if (!matchesSearch) return false;

                if (alignment !== 'all' && c.alignment !== alignment) return false;
                if (currentGenreFilter !== 'all' && c.genre !== currentGenreFilter) return false;

                return true;
            });

            filtered.sort((a, b) => {
                if (sort === 'trending') return b.likes - a.likes;
                if (sort === 'power') return calculatePowerScore(b.stats) - calculatePowerScore(a.stats);
                if (sort === 'alphabetical') return a.name.localeCompare(b.name);
                return 0;
            });

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            grid.innerHTML = filtered.map(c => {
                const isLiked = c.likedBy.includes(currentPersona.handle);
                const isAuthor = c.authorHandle === currentPersona.handle;
                const power = calculatePowerScore(c.stats);

                return `
                    <div class="glass-card holo-card rounded-2xl p-6 flex flex-col justify-between relative group">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                ${getGenreBadgeHTML(c.genre)}
                                <span class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300">
                                    ${c.status === 'published' ? '<i class="fa-solid fa-globe text-cyan-400 mr-1"></i>PUBLISHED' : '<i class="fa-solid fa-lock text-amber-400 mr-1"></i>DRAFT'}
                                </span>
                            </div>

                            <div class="flex items-start space-x-4 mb-4">
                                <img src="${c.avatar}" class="w-16 h-16 rounded-xl object-cover border-2 border-slate-700 group-hover:border-cyan-400 transition">
                                <div>
                                    <h3 class="font-cinzel text-lg font-bold text-white leading-snug hover:text-cyan-400 cursor-pointer transition" onclick="openDossierModal('${c.id}')">
                                        ${c.name}
                                    </h3>
                                    <p class="text-xs font-orbitron text-cyan-400 mb-1">${c.title}</p>
                                    <button onclick="openProfileModal('${c.authorHandle}')" class="text-[11px] text-slate-400 hover:text-slate-200 flex items-center gap-1">
                                        <i class="fa-solid fa-feather text-cyan-500"></i> ${c.authorHandle}
                                    </button>
                                </div>
                            </div>

                            <p class="text-xs text-slate-300 line-clamp-3 mb-4 leading-relaxed">
                                "${c.backstory}"
                            </p>
                        </div>

                        <div class="pt-4 border-t border-slate-800/80 space-y-3">
                            <div class="flex items-center justify-between text-xs font-semibold">
                                <span class="text-slate-400">Power Index</span>
                                <span class="font-mono text-cyan-400 font-bold">${power} / 100</span>
                            </div>
                            <div class="w-full h-1.5 bg-slate-900 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-cyan-500 to-pink-500 rounded-full" style="width: ${power}%"></div>
                            </div>

                            <div class="flex items-center justify-between pt-2">
                                <div class="flex items-center space-x-2">
                                    <button onclick="toggleLike('${c.id}')" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition ${isLiked ? 'bg-pink-500/20 text-pink-400 border border-pink-500/40' : 'bg-slate-900 text-slate-400 hover:text-slate-200'}">
                                        <i class="fa-${isLiked ? 'solid' : 'regular'} fa-heart ${isLiked ? 'text-pink-500' : ''}"></i>
                                        <span>${c.likes}</span>
                                    </button>
                                    <button onclick="openDossierModal('${c.id}')" class="flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-slate-900 text-slate-400 hover:text-slate-200 text-xs">
                                        <i class="fa-regular fa-comment"></i>
                                        <span>${c.comments.length}</span>
                                    </button>
                                </div>

                                <div class="flex items-center space-x-2">
                                    ${isAuthor ? `
                                        <button onclick="togglePublishStatus('${c.id}')" title="Toggle Draft/Published" class="px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-xs text-slate-300 hover:text-white">
                                            <i class="fa-solid ${c.status === 'published' ? 'fa-eye-slash text-amber-400' : 'fa-globe text-cyan-400'}"></i>
                                        </button>
                                    ` : ''}
                                    <button onclick="openDossierModal('${c.id}')" class="px-3 py-1.5 rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 text-xs font-bold hover:bg-cyan-500/20 transition">
                                        Inspect
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // ==========================================
        // 6. LIKES & PUBLISH TOGGLE LOGIC
        // ==========================================
        function toggleLike(charId) {
            const c = characters.find(item => item.id === charId);
            if (!c) return;

            const idx = c.likedBy.indexOf(currentPersona.handle);
            if (idx > -1) {
                c.likedBy.splice(idx, 1);
                c.likes = Math.max(0, c.likes - 1);
            } else {
                c.likedBy.push(currentPersona.handle);
                c.likes += 1;
            }
            saveData();
            renderRegistry();
            if (!document.getElementById('dossierModal').classList.contains('hidden')) {
                openDossierModal(charId);
            }
        }

        function togglePublishStatus(charId) {
            const c = characters.find(item => item.id === charId);
            if (!c || c.authorHandle !== currentPersona.handle) return;
            c.status = c.status === 'published' ? 'draft' : 'published';
            saveData();
            renderRegistry();
            populateArenaDropdowns();
        }

        // ==========================================
        // 7. CREATOR & LIVE PREVIEW
        // ==========================================
        function setFormStatus(status) {
            currentFormStatus = status;
            const draftBtn = document.getElementById('status-btn-draft');
            const pubBtn = document.getElementById('status-btn-published');

            if (status === 'draft') {
                draftBtn.className = "px-4 py-2 rounded-lg text-xs font-bold transition bg-amber-500 text-slate-950 font-semibold shadow-lg shadow-amber-500/30";
                pubBtn.className = "px-4 py-2 rounded-lg text-xs font-bold transition text-slate-400";
            } else {
                pubBtn.className = "px-4 py-2 rounded-lg text-xs font-bold transition bg-cyan-500 text-slate-950 font-semibold shadow-lg shadow-cyan-500/30";
                draftBtn.className = "px-4 py-2 rounded-lg text-xs font-bold transition text-slate-400";
            }
        }

