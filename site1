        function closeDossierModal() {
            document.getElementById('dossierModal').classList.add('hidden');
        }

        function postComment(e, charId) {
            e.preventDefault();
            const input = document.getElementById('commentText');
            const text = input.value.trim();
            if (!text) return;

            const c = characters.find(item => item.id === charId);
            if (!c) return;

            c.comments.push({
                id: "comm-" + Date.now(),
                authorHandle: currentPersona.handle,
                text: text,
                likes: 0,
                likedBy: [],
                timestamp: "Just now"
            });

            saveData();
            renderRegistry();
            openDossierModal(charId);
        }

        function deleteComment(charId, commId) {
            const c = characters.find(item => item.id === charId);
            if (!c) return;
            c.comments = c.comments.filter(item => item.id !== commId);
            saveData();
            renderRegistry();
            openDossierModal(charId);
        }

        function downloadJSON(charId) {
            const c = characters.find(item => item.id === charId);
            if (!c) return;
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(c, null, 2));
            const dlAnchor = document.createElement('a');
            dlAnchor.setAttribute("href", dataStr);
            dlAnchor.setAttribute("download", `${c.name.replace(/\s+/g, '_')}_dossier.json`);
            document.body.appendChild(dlAnchor);
            dlAnchor.click();
            dlAnchor.remove();
        }

        function copyMarkdown(charId) {
            const c = characters.find(item => item.id === charId);
            if (!c) return;
            const md = `# ${c.name} - ${c.title}
**Genre:** ${c.genre} | **Alignment:** ${c.alignment} | **Author:** ${c.authorHandle}
**Power Score:** ${calculatePowerScore(c.stats)}/100

## Lore Backstory
${c.backstory}

## Tactical Attributes
- STR: ${c.stats.str}
- AGI: ${c.stats.agi}
- INT: ${c.stats.int}
- MAG: ${c.stats.mag}
- CHA: ${c.stats.cha}

**Signature Ability:** ${c.ability}
**Weakness:** ${c.weakness}`;
            navigator.clipboard.writeText(md);
            alert("Markdown Dossier copied to clipboard!");
        }

        // ==========================================
        // 9. AUTHOR PROFILE OVERLAY
        // ==========================================
        function openProfileModal(handle) {
            const p = personas.find(item => item.handle === handle) || { handle: handle, name: handle, avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100", bio: "Lore Explorer" };
            const modal = document.getElementById('authorModal');
            const content = document.getElementById('authorModalContent');

            const isCurrent = p.handle === currentPersona.handle;
            const authorChars = characters.filter(c => c.authorHandle === handle && (c.status === 'published' || isCurrent));
            const totalLikes = authorChars.reduce((sum, c) => sum + c.likes, 0);

            content.innerHTML = `
                <div class="flex items-center space-x-4">
                    <img src="${p.avatar}" class="w-16 h-16 rounded-2xl object-cover border-2 border-cyan-400">
                    <div>
                        <h2 class="font-cinzel text-xl font-bold text-white">${p.name}</h2>
                        <p class="text-xs font-orbitron text-cyan-400">${p.handle}</p>
                        <p class="text-xs text-slate-300 mt-1">${p.bio}</p>
                    </div>
                </div>

                ${isCurrent ? `
                    <form onsubmit="saveProfileEdit(event)" class="glass-card p-4 rounded-xl border border-cyan-500/30 space-y-3">
                        <h3 class="text-xs font-bold font-orbitron text-cyan-400 uppercase tracking-wider">Customize Active Persona</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <input type="text" id="editPersonaName" value="${p.name}" required placeholder="Display Name" class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200">
                            <input type="url" id="editPersonaAvatar" value="${p.avatar}" required placeholder="Avatar URL" class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200">
                        </div>
                        <input type="text" id="editPersonaBio" value="${p.bio}" placeholder="Author Bio" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200">
                        <button type="submit" class="px-4 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-bold text-xs hover:bg-cyan-400 transition">Save Profile Changes</button>
                    </form>
                ` : ''}

                <div class="grid grid-cols-2 gap-4">
                    <div class="glass-card p-4 rounded-xl text-center border border-slate-800">
                        <p class="text-xl font-bold font-orbitron text-cyan-400">${authorChars.length}</p>
                        <p class="text-[10px] text-slate-400 uppercase">Codex Characters</p>
                    </div>
                    <div class="glass-card p-4 rounded-xl text-center border border-slate-800">
                        <p class="text-xl font-bold font-orbitron text-pink-400">${totalLikes}</p>
                        <p class="text-[10px] text-slate-400 uppercase">Total Likes Earned</p>
                    </div>
                </div>

                <div>
                    <h3 class="text-xs font-bold font-orbitron text-slate-400 uppercase tracking-wider mb-3">Character Portfolio</h3>
                    <div class="space-y-2 max-h-48 overflow-y-auto">
                        ${authorChars.length === 0 ? '<p class="text-xs text-slate-500 italic">No characters yet.</p>' : ''}
                        ${authorChars.map(c => `
                            <div onclick="closeAuthorModal(); openDossierModal('${c.id}')" class="glass-card p-3 rounded-xl border border-slate-800 hover:border-cyan-500/40 cursor-pointer flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-bold text-white">${c.name} <span class="text-[10px] text-slate-400">(${c.status})</span></p>
                                    <p class="text-[10px] text-cyan-400">${c.title}</p>
                                </div>
                                <span class="text-xs font-mono text-pink-400">❤️ ${c.likes}</span>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;

            modal.classList.remove('hidden');
        }

        function saveProfileEdit(e) {
            e.preventDefault();
            currentPersona.name = document.getElementById('editPersonaName').value.trim();
            currentPersona.avatar = document.getElementById('editPersonaAvatar').value.trim();
            currentPersona.bio = document.getElementById('editPersonaBio').value.trim();
            const idx = personas.findIndex(p => p.handle === currentPersona.handle);
            if (idx > -1) personas[idx] = currentPersona;
            saveData();
            renderPersonaDropdown();
            openProfileModal(currentPersona.handle);
        }

        function closeAuthorModal() {
            document.getElementById('authorModal').classList.add('hidden');
        }

        // ==========================================
        // 10. BATTLE ARENA SIMULATOR
        // ==========================================
        function populateArenaDropdowns() {
            const pubChars = characters.filter(c => c.status === 'published');
            const select1 = document.getElementById('arenaFighter1');
            const select2 = document.getElementById('arenaFighter2');

            if (pubChars.length < 2) return;

            select1.innerHTML = pubChars.map(c => `<option value="${c.id}">${c.name} (${c.genre})</option>`).join('');
            select2.innerHTML = pubChars.map((c, idx) => `<option value="${c.id}" ${idx === 1 ? 'selected' : ''}>${c.name} (${c.genre})</option>`).join('');

            updateArenaPreview();
        }

        function updateArenaPreview() {
            const id1 = document.getElementById('arenaFighter1').value;
            const id2 = document.getElementById('arenaFighter2').value;

            const c1 = characters.find(c => c.id === id1);
            const c2 = characters.find(c => c.id === id2);

            if (c1) {
                document.getElementById('arenaPreview1').innerHTML = `
                    <img src="${c1.avatar}" class="w-20 h-20 mx-auto rounded-xl object-cover border-2 border-cyan-400 mb-2">
                    <h4 class="font-cinzel text-base font-bold text-white">${c1.name}</h4>
                    <p class="text-xs text-cyan-400 font-orbitron">${c1.title}</p>
                    <p class="text-xs font-mono text-slate-300">Power Score: ${calculatePowerScore(c1.stats)}</p>
                `;
            }

            if (c2) {
                document.getElementById('arenaPreview2').innerHTML = `
                    <img src="${c2.avatar}" class="w-20 h-20 mx-auto rounded-xl object-cover border-2 border-pink-400 mb-2">
                    <h4 class="font-cinzel text-base font-bold text-white">${c2.name}</h4>
                    <p class="text-xs text-pink-400 font-orbitron">${c2.title}</p>
                    <p class="text-xs font-mono text-slate-300">Power Score: ${calculatePowerScore(c2.stats)}</p>
                `;
            }
        }

        function runBattleSimulation() {
            const id1 = document.getElementById('arenaFighter1').value;
            const id2 = document.getElementById('arenaFighter2').value;

            if (id1 === id2) {
                alert("Please select two distinct fighters for the arena duel!");
                return;
            }

            const c1 = characters.find(c => c.id === id1);
            const c2 = characters.find(c => c.id === id2);

            const container = document.getElementById('combatLogContainer');
            const logText = document.getElementById('combatLogText');
            container.classList.remove('hidden');

            let p1 = calculatePowerScore(c1.stats) + Math.floor(Math.random() * 20);
            let p2 = calculatePowerScore(c2.stats) + Math.floor(Math.random() * 20);

            let logs = [];
            logs.push(`[SYSTEM] Initializing Multiverse Combat Matrix...`);
            logs.push(`[ROUND 1] ${c1.name} initiates with ${c1.ability || 'Standard Attack'}! Attack power roll: ${p1}`);
            logs.push(`[ROUND 2] ${c2.name} counters with ${c2.ability || 'Energy Counter'}! Defense power roll: ${p2}`);
            
            if (p1 > p2) {
                logs.push(`[CRITICAL] ${c1.name} exploits ${c2.name}'s weakness (${c2.weakness || 'vulnerability'})!`);
                logs.push(`[VICTORY] 🎉 ${c1.name} achieves dominant victory over ${c2.name}!`);
            } else if (p2 > p1) {
                logs.push(`[CRITICAL] ${c2.name} turns the tide with an unexpected surge against ${c1.weakness || 'defense'}!`);
                logs.push(`[VICTORY] 🎉 ${c2.name} achieves dominant victory over ${c1.name}!`);
            } else {
                logs.push(`[STALEMATE] Both entities release equal energy forces resulting in a tactical draw!`);
            }

            logText.innerHTML = logs.map(l => `<p class="py-1 border-b border-slate-900">${l}</p>`).join('');
        }

        // ==========================================
        // 11. LORE SPARK GENERATOR
        // ==========================================
        let lastSpark = null;

        function generateLoreSpark() {
            const names = ["Valerius Shadowmancer", "Cipher 99", "Baroness Clockwork", "Ignis Solaris", "Vespera Nyx", "Captain Lyra Nova"];
            const titles = ["The Astral Weaver", "Architect of Neon", "High Sky Captain", "The Ember Knight", "Dread Void Seeker", "Starborn Vanguard"];
            const genres = ["Fantasy", "Sci-Fi", "Cyberpunk", "Steampunk", "Horror", "Superhero"];
            const alignments = ["Lawful Good", "Chaotic Good", "True Neutral", "Chaotic Neutral", "Lawful Evil", "Chaotic Evil"];

            const randomName = names[Math.floor(Math.random() * names.length)];
            const randomTitle = titles[Math.floor(Math.random() * titles.length)];
            const randomGenre = genres[Math.floor(Math.random() * genres.length)];
            const randomAlignment = alignments[Math.floor(Math.random() * alignments.length)];

            lastSpark = {
                name: randomName,
                title: randomTitle,
                genre: randomGenre,
                alignment: randomAlignment,
                backstory: `Born amidst the nexus of ${randomGenre} realms, ${randomName} carries a sacred artifact capable of altering quantum timelines and reshaping destiny.`
            };

            document.getElementById('sparkName').textContent = lastSpark.name;
            document.getElementById('sparkTitle').textContent = lastSpark.title;
            document.getElementById('sparkAlignment').textContent = lastSpark.alignment;
            document.getElementById('sparkBackstory').textContent = `"${lastSpark.backstory}"`;
            document.getElementById('sparkGenreBadgeWrapper').innerHTML = getGenreBadgeHTML(lastSpark.genre);

            document.getElementById('sparkResultContainer').classList.remove('hidden');
        }

        function importSparkToCreator() {
            if (!lastSpark) return;
            switchTab('creator');
            document.getElementById('inputName').value = lastSpark.name;
            document.getElementById('inputTitle').value = lastSpark.title;
            document.getElementById('inputGenre').value = lastSpark.genre;
            document.getElementById('inputAlignment').value = lastSpark.alignment;
            document.getElementById('inputBackstory').value = lastSpark.backstory;
            updateLivePreview();
        }
    </script>
</body>
</html>
