                                <i class="fa-solid fa-download"></i> Download JSON
                            </button>
                            <button onclick="copyMarkdown('${c.id}')" class="px-4 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs font-bold text-slate-300 hover:text-white flex items-center gap-2">
