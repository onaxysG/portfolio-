                        <div class="glass-card p-4 rounded-xl border border-slate-800 space-y-3">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-400">Genre:</span>
                                ${getGenreBadgeHTML(c.genre)}
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-400">Moral Alignment:</span>
                                <span class="font-mono text-cyan-400 font-semibold">${c.alignment}</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-400">Author:</span>
                                <button onclick="closeDossierModal(); openProfileModal('${c.authorHandle}')" class="text-slate-200 hover:text-cyan-400 font-semibold">
                                    ${c.authorHandle}
                                </button>
                            </div>
                        </div>

                        <div class="glass-card p-4 rounded-xl border border-slate-800 space-y-3">
                            <h4 class="text-xs font-bold font-orbitron text-cyan-400 uppercase tracking-wider">Attribute Matrix</h4>
                            <div class="space-y-2 text-xs">
                                ${['str', 'agi', 'int', 'mag', 'cha'].map(statKey => {
                                    const labels = { str: 'Strength', agi: 'Agility', int: 'Intelligence', mag: 'Magic / Energy', cha: 'Charisma' };
                                    return `
                                        <div>
                                            <div class="flex justify-between text-slate-300 font-mono mb-1">
                                                <span>${labels[statKey]}</span><span>${c.stats[statKey]}</span>
                                            </div>
                                            <div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden">
